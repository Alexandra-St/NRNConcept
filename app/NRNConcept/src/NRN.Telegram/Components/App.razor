@inject MiniAppPreferencesState Preferences

<!DOCTYPE html>
<html lang="@Preferences.Language">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#f4f4f2" />
    <base href="@(string.IsNullOrWhiteSpace(PathBase) ? "/" : $"{PathBase.TrimEnd('/')}/")" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["NRN.Telegram.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
    <script src="https://telegram.org/js/telegram-web-app.js?63"></script>
    <script src="@Assets["telegram.js"]"></script>
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [Inject] private IConfiguration Configuration { get; set; } = default!;

    private string? PathBase => Configuration["PathBase"];
}
