@page "/app/services"
@inject UserServicesState UserServices
@inject TelegramSessionState TelegramSession
@inject MiniAppLocalizer T
@implements IDisposable

<PageTitle>@T["services.title"]</PageTitle>

<header class="standard-header">
    <p class="eyebrow">NRN</p>
    <h1>@T["services.heading"]</h1>
    <p>@T["services.description"]</p>
</header>

@if (UserServices.Status == UserServicesStatus.Ready && UserServices.ConnectedServices.Count > 0)
{
    @if (UserServices.HasRefreshError)
    {
        <div class="action-notice" role="alert">
            <span>@T["services.refreshError"]</span>
            <button type="button" disabled="@UserServices.IsRefreshing" @onclick="RetryAsync">@T["common.retry"]</button>
        </div>
    }
    <div class="card-list">
        @foreach (var service in UserServices.ConnectedServices)
        {
            <article class="content-card">
                <div class="card-title-row">
                    <span class="service-icon"><AppIcon Name="shield" /></span>
                    <span class="status-pill">@T.ServiceStatus(service.Status)</span>
                </div>
                <h2>@T.ProductName(service.Id, service.Name)</h2>
                <p>@T.ProductDescription(service.Id, service.Description)</p>
                <div class="card-meta">
                    <span>@T["services.validity"]</span>
                    <strong>@T.ServiceStatusDetail(service.StatusDetail)</strong>
                </div>
            </article>
        }
    </div>

    <a class="primary-action" href="app/catalog">@T["services.add"]</a>
}
else if (UserServices.Status == UserServicesStatus.Ready)
{
    <ContentState Title="@T["services.emptyTitle"]" Message="@T["services.empty"]" ActionLabel="@T["services.choose"]" ActionHref="app/catalog" />
}
else if (UserServices.Status == UserServicesStatus.Unauthorized)
{
    <div class="state-card">@T["services.unauthorized"]</div>
}
else if (UserServices.Status == UserServicesStatus.Error)
{
    <ContentState Kind="error" Title="@T["services.errorTitle"]" Message="@LoadErrorMessage" ActionLabel="@T["common.retry"]" Action="RetryAsync" />
}
else
{
    <LoadingState Label="@T["services.loading"]" Rows="2" />
}

@code {
    protected override void OnInitialized() => UserServices.Changed += HandleStateChanged;

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);
    private string LoadErrorMessage => T[UserServices.LoadErrorKey ?? "services.error"];

    private Task RetryAsync() => UserServices.LoadAsync(TelegramSession);

    public void Dispose() => UserServices.Changed -= HandleStateChanged;
}
