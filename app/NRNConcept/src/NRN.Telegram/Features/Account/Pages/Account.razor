@page "/app/account"
@inject TelegramSessionState TelegramSession
@inject UserServicesState UserServices
@inject MiniAppLocalizer T
@implements IDisposable

<PageTitle>@T["account.title"]</PageTitle>
<TelegramChrome BackHref="app" />

<header class="standard-header">
    <p class="eyebrow">@T["account.eyebrow"]</p>
    <h1>@T["account.heading"]</h1>
    <p>@AccountDescription</p>
</header>

@if (TelegramSession.Status == TelegramSessionStatus.Loading)
{
    <LoadingState Label="@T["account.loading"]" Rows="2" />
}
else if (TelegramSession.Status == TelegramSessionStatus.Rejected)
{
    <section class="state-card account-unavailable" role="alert">
        <strong>@T["account.unavailableHeading"]</strong>
        <span>@T["account.unavailableDescription"]</span>
    </section>
}
else
{
    @if (UserServices.Status == UserServicesStatus.Error)
    {
        <ContentState Kind="error" Title="@T["services.errorTitle"]" Message="@LoadErrorMessage" ActionLabel="@T["common.retry"]" Action="RetryAsync" />
    }
    <section class="content-card account-card">
        <div class="account-avatar">@Initial</div>
        <div class="account-identity">
            <span class="account-mode account-mode--@AccountModeClass">@AccountMode</span>
            <h2>@DisplayName</h2>
            <span class="account-username">@Username</span>
        </div>
    </section>

    <section class="balance-card" aria-label="@T["account.balance"]">
        <span>@T["account.balance"]</span>
        <strong>@Balance</strong>
        <small>@T["account.balanceHint"]</small>
    </section>

    <section class="account-grid" aria-label="@T["account.details"]">
        <article class="content-card">
            <span class="account-label">@T["account.connectedServices"]</span>
            <strong>@ConnectedServices</strong>
        </article>
        <article class="content-card">
            <span class="account-label">@T["account.telegramId"]</span>
            <strong>@TelegramId</strong>
        </article>
    </section>

    <nav class="account-links" aria-label="@T["account.actions"]">
        <a href="app/services">
            <span>
                <strong>@T["account.openServices"]</strong>
                <small>@T["account.openServicesHint"]</small>
            </span>
            <span aria-hidden="true">→</span>
        </a>
        <a href="app/language">
            <span>
                <strong>@T["account.language"]</strong>
                <small>@T["account.languageHint"]</small>
            </span>
            <span>@T["account.currentLanguage"]</span>
        </a>
    </nav>
}

@code {
    private bool IsPreview => TelegramSession.Status == TelegramSessionStatus.Preview;
    private string DisplayName => TelegramSession.User is { } user
        ? string.Join(' ', new[] { user.FirstName, user.LastName }.Where(part => !string.IsNullOrWhiteSpace(part)))
        : T["account.demoUser"];
    private string Initial => DisplayName.Length > 0 ? DisplayName[..1].ToUpperInvariant() : "N";
    private string Username => TelegramSession.User?.Username is { Length: > 0 } username
        ? $"@@{username}"
        : IsPreview ? "TelegramUser_demo" : T["account.usernameNotSet"];
    private string TelegramId => TelegramSession.User?.Id.ToString() ?? T["account.demoEnvironment"];
    private string Balance => UserServices.Status == UserServicesStatus.Ready
        ? $"{UserServices.Balance:0.##} {UserServices.Currency}"
        : T["account.notAvailable"];
    private string ConnectedServices => UserServices.Status == UserServicesStatus.Ready
        ? UserServices.ConnectedServices.Count.ToString()
        : T["account.notAvailable"];
    private string AccountMode => IsPreview ? T["account.demoMode"] : T["account.verifiedMode"];
    private string AccountModeClass => IsPreview ? "demo" : "verified";
    private string AccountDescription => TelegramSession.Status switch
    {
        TelegramSessionStatus.Preview => T["account.previewDescription"],
        TelegramSessionStatus.Authenticated => T["account.description"],
        TelegramSessionStatus.Rejected => T["account.unavailableDescription"],
        _ => T["account.loadingDescription"]
    };

    protected override void OnInitialized()
    {
        TelegramSession.Changed += HandleStateChanged;
        UserServices.Changed += HandleStateChanged;
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);
    private string LoadErrorMessage => T[UserServices.LoadErrorKey ?? "services.error"];

    private Task RetryAsync() => UserServices.LoadAsync(TelegramSession);

    public void Dispose()
    {
        TelegramSession.Changed -= HandleStateChanged;
        UserServices.Changed -= HandleStateChanged;
    }
}
