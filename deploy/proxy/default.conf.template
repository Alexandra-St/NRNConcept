map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen ${PORT};
    server_name _;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "healthy\n";
    }

    location = /miniapp {
        return 308 /miniapp/;
    }

    location /miniapp/ {
        proxy_pass ${MINIAPP_SCHEME}://${MINIAPP_HOST}:${MINIAPP_PORT};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${MINIAPP_HOST};
        proxy_set_header Host ${MINIAPP_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        proxy_pass ${LAB_SCHEME}://${LAB_HOST}:${LAB_PORT};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${LAB_HOST};
        proxy_set_header Host ${LAB_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
